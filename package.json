{
  "name": "reafence",
  "version": "0.1.0",
  "description": "Local-first reverse-engineering audits and human-approved hardening for JavaScript and Electron apps. Powered by REA.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyl1u/ReaFence.git"
  },
  "homepage": "https://github.com/flyl1u/ReaFence#readme",
  "bugs": {
    "url": "https://github.com/flyl1u/ReaFence/issues"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "bin": {
    "reafence": "bin/reafence.mjs"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "docs",
    "examples",
    "README.md",
    "README.en.md",
    "AGENTS.md",
    "SECURITY.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "scripts/benchmark.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "test:rea": "node scripts/verify-rea.mjs",
    "test:mcp": "node scripts/verify-mcp.mjs",
    "test:electron": "node scripts/verify-electron.mjs",
    "test:package": "node scripts/verify-package.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@babel/parser": "8.0.7",
    "@electron/asar": "4.3.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "commander": "15.0.0",
    "javascript-obfuscator": "5.9.0",
    "rea-agents": "6.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "electron": "45.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
